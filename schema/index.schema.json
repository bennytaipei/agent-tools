{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-tools.local/schema/index.schema.json",
  "title": "Catalog namespace index",
  "description": "Level one of the catalog. Each namespace has a one-line description and the path of its folder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespaces"],
  "properties": {
    "namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "path"],
        "properties": {
          "name": {
            "description": "Namespace folder name. Lowercase snake_case.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "description": {
            "description": "One line describing the namespace.",
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
          },
          "path": {
            "description": "Path of the namespace folder relative to the repository root. Equal to catalog/<name>.",
            "type": "string",
            "pattern": "^catalog/[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
