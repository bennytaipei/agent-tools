#!/bin/sh
# Launch the browser MCP server in Docker or Podman.
# Stdio is the container's stdio. --build builds the image and exits.
# --ensure-engine brings the engine and image up, then exits.
#
# States:
#   engine_down(kind, detail) — info failed and a stopped Podman machine
#     or Docker Desktop can be started.
#   starting — start was issued, or the machine is already Running or
#     Starting while info still fails (a fresh boot).
#   ready — engine info succeeded and the image exists. Only ready runs
#     the container directly.
#   failed(reason, fix) — the engine never became ready, start was
#     refused, cancelled, or impossible to ask, the image is missing, or
#     never-mode left the engine stopped. Hands off to the degraded MCP
#     server (runtimes/browser/bin/agent-tools-browser-degraded).
#
# AGENT_TOOLS_AUTO_START_ENGINE defaults to always. ask and never keep
# their previous behavior. See runtimes/browser/README.md.
set -eu

BASE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$BASE/../../.." && pwd)

usage() {
  printf '%s\n' "usage: agent-tools-browser [--build|--ensure-engine]" >&2
}

BUILD=0
ENSURE=0
if [ "$#" -gt 1 ]; then
  usage
  exit 2
fi
if [ "$#" -eq 1 ]; then
  case $1 in
    --build) BUILD=1 ;;
    --ensure-engine) ENSURE=1 ;;
    *)
      usage
      exit 2
      ;;
  esac
fi

# Logging must never break the launcher. Messages also go to stderr.
init_log() {
  LOG_FILE=${AGENT_TOOLS_LOG_FILE:-}
  if [ -z "$LOG_FILE" ]; then
    uname_s=$(uname -s 2>/dev/null || echo unknown)
    if [ "$uname_s" = "Darwin" ]; then
      LOG_FILE=${HOME:-/tmp}/Library/Logs/agent-tools-browser.log
    else
      state=${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}
      LOG_FILE=$state/agent-tools/browser.log
    fi
  fi
  if [ -z "$LOG_FILE" ]; then
    LOG_FILE=/tmp/agent-tools-browser.log
  fi
  export AGENT_TOOLS_LOG_FILE="$LOG_FILE"
  log_dir=$(dirname -- "$LOG_FILE" 2>/dev/null || true)
  if [ -n "$log_dir" ]; then
    mkdir -p "$log_dir" 2>/dev/null || true
  fi
  if [ -f "$LOG_FILE" ]; then
    bytes=$(wc -c < "$LOG_FILE" 2>/dev/null || true)
    bytes=${bytes##* }
    case ${bytes:-} in
      ""|*[!0-9]*) bytes=0 ;;
    esac
    if [ "$bytes" -gt 5242880 ]; then
      if tail -c 1048576 "$LOG_FILE" > "$LOG_FILE.tail" 2>/dev/null; then
        mv "$LOG_FILE.tail" "$LOG_FILE" 2>/dev/null || true
      fi
    fi
  fi
}

log_line() {
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)
  printf '%s %s %s\n' "$ts" "$$" "$1" >> "$LOG_FILE" 2>/dev/null || true
}

say() {
  log_line "$1"
  printf '%s\n' "$1" >&2 || true
}

init_log

AUTO_START=${AGENT_TOOLS_AUTO_START_ENGINE:-always}
case $AUTO_START in
  always|ask|never) ;;
  *)
    say "AGENT_TOOLS_AUTO_START_ENGINE must be always, ask, or never."
    exit 2
    ;;
esac

START_TIMEOUT=${AGENT_TOOLS_ENGINE_START_TIMEOUT:-120}
case $START_TIMEOUT in
  *[!0-9]*)
    say "AGENT_TOOLS_ENGINE_START_TIMEOUT must be a positive integer."
    exit 2
    ;;
esac
if [ "$START_TIMEOUT" -lt 1 ]; then
  say "AGENT_TOOLS_ENGINE_START_TIMEOUT must be a positive integer."
  exit 2
fi

log_line "auto-start: $AUTO_START timeout ${START_TIMEOUT}s"

# failed(reason, fix). Does not return.
fail() {
  reason=$1
  fix=$2
  log_line "state failed: $reason"
  log_line "fix: $fix"
  printf '%s\n' "$reason" >&2 || true
  if [ "$ENSURE" -eq 1 ]; then
    printf 'REASON:%s\nFIX:%s\n' "$reason" "$fix"
    exit 1
  fi
  if [ "$BUILD" -eq 1 ] || [ "${AGENT_TOOLS_NO_DEGRADED:-}" = "1" ]; then
    exit 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    log_line "python3 missing; exiting without a degraded server"
    exit 1
  fi
  log_line "degraded handoff"
  AGENT_TOOLS_DEGRADED_REASON=$reason
  AGENT_TOOLS_DEGRADED_FIX=$fix
  export AGENT_TOOLS_DEGRADED_REASON AGENT_TOOLS_DEGRADED_FIX
  PYTHONUNBUFFERED=1
  export PYTHONUNBUFFERED
  exec python3 "$BASE/agent-tools-browser-degraded"
}

# A podman-docker shim answers `docker` but prints podman in its version or info.
docker_is_podman_shim() {
  out=$(docker --version 2>&1 || true)
  case $out in
    *[Pp]odman*) return 0 ;;
  esac
  out=$(docker info 2>&1 || true)
  case $out in
    *[Pp]odman*) return 0 ;;
  esac
  return 1
}

# stdout of these probes stays off MCP stdout.
desktop_status_stopped() {
  status=$("$1" desktop status 2>/dev/null || true)
  case $status in
    *[Ss]topped*|*[Nn]ot\ [Rr]unning*) return 0 ;;
  esac
  return 1
}

# 0 when a stopped machine should be started (STOPPED_MACHINE set).
# 1 when a machine is Running or Starting (MACHINE_PHASE=live), or when
# there is nothing to start (MACHINE_PHASE=absent). A trailing * on the
# default machine's name is Podman 5's marker and is not part of the name.
podman_machine_stopped() {
  STOPPED_MACHINE=
  MACHINE_PHASE=absent
  MACHINE_BIN=$ENGINE
  if [ "$STYLE" = "podman" ] && command -v podman >/dev/null 2>&1; then
    MACHINE_BIN=podman
  fi
  list=$("$MACHINE_BIN" machine list --format '{{.Name}} {{.Running}} {{.Starting}} {{.Default}}' 2>/dev/null || true)
  [ -n "$list" ] || return 1
  chosen=
  live=0
  saved_ifs=$IFS
  IFS='
'
  for line in $list; do
    [ -n "$line" ] || continue
    name=${line%% *}
    case $name in
      *\*) name=${name%\*} ;;
    esac
    rest=${line#* }
    running=${rest%% *}
    rest=${rest#* }
    starting=${rest%% *}
    default=${rest#* }
    case $running in
      true) live=1 ;;
    esac
    case $starting in
      true) live=1 ;;
    esac
    case $default in
      true) chosen=$name ;;
    esac
    if [ -z "$chosen" ]; then
      chosen=$name
    fi
  done
  IFS=$saved_ifs
  if [ "$live" -eq 1 ]; then
    MACHINE_PHASE=live
    log_line "podman machines: phase=live"
    return 1
  fi
  [ -n "$chosen" ] || return 1
  STOPPED_MACHINE=$chosen
  MACHINE_PHASE=stopped
  log_line "podman machines: phase=stopped name=$STOPPED_MACHINE"
  return 0
}

# 0 = start, 1 = denied, 2 = no way to ask.
# MCP stdin and stdout are not used. macOS uses an osascript dialog.
# Everywhere else reads the answer from /dev/tty.
ask_start() {
  question=$1
  uname_s=$(uname -s)
  if [ "$uname_s" = "Darwin" ]; then
    if ! command -v osascript >/dev/null 2>&1; then
      return 2
    fi
    if osascript -e "display dialog \"${question}\" buttons {\"Start\", \"Cancel\"} default button \"Start\" cancel button \"Cancel\" with title \"agent-tools-browser\"" >/dev/null 2>&1; then
      return 0
    fi
    return 1
  fi
  if ! (: </dev/tty >/dev/tty) 2>/dev/null; then
    return 2
  fi
  printf '%s [y/N]\n' "$question" > /dev/tty
  answer=
  if ! IFS= read -r answer < /dev/tty; then
    return 2
  fi
  case $answer in
    y|Y|yes|YES) return 0 ;;
  esac
  return 1
}

INFO_LOGGED=0
engine_info_ok() {
  out=/tmp/agent-tools-info-$$
  status=0
  "$ENGINE" info >"$out" 2>&1 || status=$?
  if [ "$status" -eq 0 ]; then
    rm -f "$out" 2>/dev/null || true
    return 0
  fi
  if [ "$INFO_LOGGED" -eq 0 ] && [ -s "$out" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      log_line "info: $line"
      printf '%s\n' "$line" >&2 || true
    done < "$out"
    INFO_LOGGED=1
  fi
  rm -f "$out" 2>/dev/null || true
  return "$status"
}

wait_until_ready() {
  log_line "state starting: waiting for $ENGINE info (timeout ${START_TIMEOUT}s)"
  waited=0
  while :; do
    if engine_info_ok; then
      return 0
    fi
    if [ "$waited" -ge "$START_TIMEOUT" ]; then
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

append_start_output() {
  start_out=$1
  if [ -s "$start_out" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      log_line "start: $line"
      printf '%s\n' "$line" >&2 || true
    done < "$start_out"
  fi
  rm -f "$start_out" 2>/dev/null || true
}

# Start a stopped Podman machine or Docker Desktop, or wait out a fresh
# boot, until info succeeds. Calls fail and does not return otherwise.
bring_up_engine() {
  if engine_info_ok; then
    log_line "engine info ok: $ENGINE"
    return 0
  fi
  log_line "engine info failed: $ENGINE"
  kind=
  detail=
  action=fail
  if [ "$STYLE" = "podman" ]; then
    if podman_machine_stopped; then
      kind=machine
      detail="The Podman machine is stopped."
      action=start
    elif [ "${MACHINE_PHASE:-}" = "live" ]; then
      detail="The Podman machine is already running or starting."
      action=wait
    else
      detail="podman info failed."
      action=fail
    fi
  elif desktop_status_stopped "$ENGINE"; then
    kind=desktop
    detail="Docker Desktop is not running."
    action=start
  else
    detail="$ENGINE info failed."
    action=fail
  fi

  if [ "$action" = "fail" ]; then
    if [ "$STYLE" = "podman" ]; then
      fail "$detail" 'Run `podman machine start`'
    else
      fail "$detail" "Run \`$ENGINE info\`"
    fi
  fi

  if [ "$action" = "wait" ]; then
    log_line "state starting: $detail"
    if ! wait_until_ready; then
      fail "Timed out after ${START_TIMEOUT}s waiting for ${ENGINE} to become ready." \
        'Run `podman machine start`'
    fi
    log_line "engine info ok: $ENGINE"
    return 0
  fi

  log_line "state engine_down: $kind $detail"
  case $AUTO_START in
    never)
      fail "$detail Refusing to start it because AGENT_TOOLS_AUTO_START_ENGINE=never." \
        'Set AGENT_TOOLS_AUTO_START_ENGINE=always'
      ;;
    ask)
      rc=0
      ask_start "$detail Start it?" || rc=$?
      if [ "$rc" -eq 1 ]; then
        if [ "$kind" = "machine" ]; then
          fix='Run `podman machine start`'
        else
          fix='Run `docker desktop start`'
        fi
        log_line "ask: cancelled"
        fail "$detail Start was cancelled." "$fix"
      fi
      if [ "$rc" -ne 0 ]; then
        log_line "ask: no way to ask"
        fail "$detail No way to ask for permission. Set AGENT_TOOLS_AUTO_START_ENGINE=always to start it without asking." \
          'Set AGENT_TOOLS_AUTO_START_ENGINE=always'
      fi
      log_line "ask: start"
      ;;
  esac

  log_line "state starting: $kind ${STOPPED_MACHINE:-}"
  start_rc=0
  start_out=/tmp/agent-tools-start-$$
  : > "$start_out" || true
  if [ "$kind" = "machine" ]; then
    log_line "command: $MACHINE_BIN machine start $STOPPED_MACHINE"
    "$MACHINE_BIN" machine start "$STOPPED_MACHINE" </dev/null >"$start_out" 2>&1 || start_rc=$?
  else
    log_line "command: $ENGINE desktop start"
    "$ENGINE" desktop start </dev/null >"$start_out" 2>&1 || start_rc=$?
  fi
  append_start_output "$start_out"
  if [ "$start_rc" -ne 0 ]; then
    if [ "$kind" = "machine" ]; then
      say "Podman machine failed to start."
    else
      say "Docker Desktop failed to start."
    fi
    log_line "start exited $start_rc; waiting for $ENGINE info"
  fi
  if ! wait_until_ready; then
    if [ "$kind" = "machine" ]; then
      fix='Run `podman machine start`'
    else
      fix='Run `docker desktop start`'
    fi
    fail "Timed out after ${START_TIMEOUT}s waiting for ${ENGINE} to become ready." "$fix"
  fi
  log_line "engine info ok: $ENGINE"
}

image_ready() {
  out=/tmp/agent-tools-image-$$
  status=0
  if [ "$STYLE" = "podman" ]; then
    "$ENGINE" image exists "$IMAGE" >"$out" 2>&1 || status=$?
  else
    "$ENGINE" image inspect "$IMAGE" >"$out" 2>&1 || status=$?
  fi
  if [ "$status" -ne 0 ] && [ -s "$out" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      log_line "image: $line"
    done < "$out"
  fi
  rm -f "$out" 2>/dev/null || true
  return "$status"
}

ENGINE=${AGENT_TOOLS_CONTAINER_ENGINE:-}
if [ -n "$ENGINE" ]; then
  base=$(basename -- "$ENGINE")
  case $base in
    podman|podman.exe) STYLE=podman ;;
    *) STYLE=docker ;;
  esac
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  if docker_is_podman_shim; then
    if command -v podman >/dev/null 2>&1; then
      ENGINE=podman
    else
      ENGINE=docker
    fi
    STYLE=podman
  else
    ENGINE=docker
    STYLE=docker
  fi
elif command -v docker >/dev/null 2>&1 && desktop_status_stopped docker; then
  ENGINE=docker
  STYLE=docker
else
  ENGINE=podman
  STYLE=podman
fi

log_line "engine chosen: $ENGINE style=$STYLE"
IMAGE=${AGENT_TOOLS_IMAGE:-agent-tools-browser}

bring_up_engine

if [ "$BUILD" -eq 1 ]; then
  log_line "command: $ENGINE build $IMAGE"
  exec "$ENGINE" build -f "$ROOT/runtimes/browser/Containerfile" -t "$IMAGE" "$ROOT"
fi

if ! image_ready; then
  log_line "image missing: $IMAGE"
  fail "The image ${IMAGE} is missing." 'Run `agent-tools-browser --build`'
fi
log_line "state ready: $ENGINE image $IMAGE"

if [ "$ENSURE" -eq 1 ]; then
  log_line "ensure-engine ready"
  exit 0
fi

# Ports inside the container. The image listens here. Published host ports
# are chosen below and passed as AGENT_TOOLS_PUBLIC_* so the posted URL
# uses the port Benny's browser can open.
CONTAINER_HANDOFF=8765
CONTAINER_NOVNC=8766
NOTIFY=${AGENT_TOOLS_NOTIFY_PORT:-8767}
BIND=${AGENT_TOOLS_BIND_ADDRESS:-0.0.0.0}
PUBLIC=${AGENT_TOOLS_PUBLIC_HOST:-127.0.0.1}
CHANNEL=${AGENT_TOOLS_BROWSER_CHANNEL:-chromium}
VOLUME_NAME=${AGENT_TOOLS_PROFILE_VOLUME:-agent-tools-browser-profile}
PROFILE_PATH=/var/lib/agent-tools/profile

if [ "$STYLE" = "podman" ]; then
  ALIAS=host.containers.internal
  VOLUME="${VOLUME_NAME}:${PROFILE_PATH}:U"
else
  ALIAS=host.docker.internal
  VOLUME="${VOLUME_NAME}:${PROFILE_PATH}"
fi

if [ -n "${AGENT_TOOLS_NOTIFY_WEBHOOK:-}" ]; then
  WEBHOOK=$AGENT_TOOLS_NOTIFY_WEBHOOK
else
  WEBHOOK="http://${ALIAS}:${NOTIFY}/"
fi

# Unset, empty, 0, and auto pick a free host port. Any other value is explicit.
is_auto_port() {
  case ${1-} in
    ""|0|auto) return 0 ;;
  esac
  return 1
}

require_port() {
  label=$1
  value=$2
  case $value in
    *[!0-9]*)
      say "${label} is not a TCP port."
      exit 2
      ;;
  esac
  if [ "$value" -lt 1 ] || [ "$value" -gt 65535 ]; then
    say "${label} is not a TCP port."
    exit 2
  fi
}

port_busy() {
  hex=$(printf '%04X' "$1")
  for file in /proc/net/tcp /proc/net/tcp6; do
    [ -r "$file" ] || continue
    while IFS= read -r line; do
      case $line in
        *":${hex} "*) return 0 ;;
      esac
    done < "$file"
  done
  return 1
}

pick_port_scan() {
  avoid=${1-}
  port=$((20000 + ($$ % 20000)))
  last=$((port + 20000))
  if [ "$last" -gt 65000 ]; then
    last=65000
  fi
  while [ "$port" -le "$last" ]; do
    if [ "$port" != "$avoid" ] && ! port_busy "$port"; then
      printf '%s\n' "$port"
      return 0
    fi
    port=$((port + 1))
  done
  say "no free TCP port"
  return 1
}

# Print `count` free ports into `out`, one per line. python3 holds the
# sockets until `release` exists so two launches cannot take the same port.
# Without python3, scan /proc/net/tcp.
reserve_ports() {
  count=$1
  out=$2
  release=$3
  if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import os, socket, sys, time
count = int(sys.argv[1])
out = sys.argv[2]
release = sys.argv[3]
socks = []
try:
    ports = []
    for _ in range(count):
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.bind(("127.0.0.1", 0))
        sock.listen(1)
        ports.append(str(sock.getsockname()[1]))
        socks.append(sock)
    with open(out, "w", encoding="utf-8") as handle:
        handle.write("\n".join(ports) + "\n")
    while not os.path.exists(release):
        time.sleep(0.05)
finally:
    for sock in socks:
        sock.close()
' "$count" "$out" "$release" &
    PORT_HOLDER=$!
    tries=0
    while [ ! -s "$out" ]; do
      tries=$((tries + 1))
      if [ "$tries" -gt 100 ]; then
        say "could not pick a free port"
        exit 1
      fi
      if ! kill -0 "$PORT_HOLDER" 2>/dev/null; then
        say "could not pick a free port"
        exit 1
      fi
      sleep 0.05
    done
    return 0
  fi
  : > "$out"
  picked=
  n=0
  while [ "$n" -lt "$count" ]; do
    next=$(pick_port_scan "$picked") || exit 1
    printf '%s\n' "$next" >> "$out"
    picked=$next
    n=$((n + 1))
  done
}

container_token() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import secrets; print(secrets.token_hex(4))'
    return
  fi
  if [ -r /proc/sys/kernel/random/uuid ]; then
    IFS= read -r line < /proc/sys/kernel/random/uuid
    printf '%s\n' "${line%%-*}"
    return
  fi
  printf '%s\n' "$$"
}

HANDOFF_RAW=${AGENT_TOOLS_HANDOFF_PORT-}
NOVNC_RAW=${AGENT_TOOLS_NOVNC_PORT-}
handoff_auto=0
novnc_auto=0
if is_auto_port "$HANDOFF_RAW"; then
  handoff_auto=1
else
  require_port AGENT_TOOLS_HANDOFF_PORT "$HANDOFF_RAW"
  HANDOFF_HOST=$HANDOFF_RAW
fi
if is_auto_port "$NOVNC_RAW"; then
  novnc_auto=1
else
  require_port AGENT_TOOLS_NOVNC_PORT "$NOVNC_RAW"
  NOVNC_HOST=$NOVNC_RAW
fi

PORT_HOLDER=
PORT_RELEASE=
PORT_FILE=
STDERR_FIFO=
TEE_PID=
need=$((handoff_auto + novnc_auto))
if [ "$need" -gt 0 ]; then
  PORT_FILE=/tmp/agent-tools-ports-$$
  PORT_RELEASE=/tmp/agent-tools-ports-$$.release
  rm -f "$PORT_FILE" "$PORT_RELEASE"
  reserve_ports "$need" "$PORT_FILE" "$PORT_RELEASE"
  first=
  second=
  while IFS= read -r line; do
    case $line in
      ""|*[!0-9]*) continue ;;
    esac
    if [ -z "$first" ]; then
      first=$line
    elif [ -z "$second" ]; then
      second=$line
    fi
  done < "$PORT_FILE"
  if [ "$handoff_auto" -eq 1 ]; then
    HANDOFF_HOST=$first
    if [ "$novnc_auto" -eq 1 ]; then
      NOVNC_HOST=$second
    fi
  else
    NOVNC_HOST=$first
  fi
fi

if [ -z "${HANDOFF_HOST:-}" ] || [ -z "${NOVNC_HOST:-}" ]; then
  say "could not pick a free port"
  exit 1
fi
if [ "$HANDOFF_HOST" = "$NOVNC_HOST" ]; then
  say "handoff and noVNC ports must differ."
  exit 2
fi

NAME="agent-tools-browser-$$-$(container_token)"
RUN_PID=
STDIN_DUP=

cleanup() {
  trap '' EXIT HUP INT TERM
  if [ -n "${PORT_RELEASE:-}" ]; then
    printf '' > "$PORT_RELEASE" || true
  fi
  if [ -n "${PORT_HOLDER:-}" ]; then
    kill "$PORT_HOLDER" 2>/dev/null || true
    wait "$PORT_HOLDER" 2>/dev/null || true
    PORT_HOLDER=
  fi
  # Close the container stdin first so the server can save and exit.
  # The wait is only while that process is still running. A clean exit
  # clears RUN_PID before this trap, so the happy path does not sleep.
  if [ -n "${RUN_PID:-}" ]; then
    if [ -n "${STDIN_DUP:-}" ]; then
      exec 3<&-
      STDIN_DUP=
    fi
    grace=0
    while [ "$grace" -lt 4 ]; do
      if ! kill -0 "$RUN_PID" 2>/dev/null; then
        break
      fi
      sleep 1
      grace=$((grace + 1))
    done
    kill "$RUN_PID" 2>/dev/null || true
  fi
  "$ENGINE" stop -t 10 "$NAME" >/dev/null 2>&1 || true
  "$ENGINE" rm -f "$NAME" >/dev/null 2>&1 || true
  if [ -n "${RUN_PID:-}" ]; then
    wait "$RUN_PID" 2>/dev/null || true
    RUN_PID=
  fi
  if [ -n "${TEE_PID:-}" ]; then
    kill "$TEE_PID" 2>/dev/null || true
    wait "$TEE_PID" 2>/dev/null || true
    TEE_PID=
  fi
  if [ -n "${STDERR_FIFO:-}" ]; then
    rm -f "$STDERR_FIFO" || true
    STDERR_FIFO=
  fi
  if [ -n "${PORT_FILE:-}" ]; then
    rm -f "$PORT_FILE" || true
  fi
  if [ -n "${PORT_RELEASE:-}" ]; then
    rm -f "$PORT_RELEASE" || true
  fi
}
trap 'cleanup; exit 129' HUP
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
trap cleanup EXIT

if [ -n "${PORT_RELEASE:-}" ]; then
  printf '' > "$PORT_RELEASE" || true
  if [ -n "${PORT_HOLDER:-}" ]; then
    wait "$PORT_HOLDER" || true
    PORT_HOLDER=
  fi
fi

set -- run -i --rm --name "$NAME" \
  -p "127.0.0.1:${HANDOFF_HOST}:${CONTAINER_HANDOFF}" \
  -p "127.0.0.1:${NOVNC_HOST}:${CONTAINER_NOVNC}"

if [ "$STYLE" = "docker" ]; then
  uname_s=$(uname -s)
  if [ "$uname_s" = "Linux" ]; then
    set -- "$@" --add-host=host.docker.internal:host-gateway
  fi
fi

set -- "$@" \
  -v "$VOLUME" \
  -e "AGENT_TOOLS_NOTIFY_WEBHOOK=${WEBHOOK}" \
  -e "AGENT_TOOLS_BROWSER_CHANNEL=${CHANNEL}" \
  -e "AGENT_TOOLS_BIND_ADDRESS=${BIND}" \
  -e "AGENT_TOOLS_PUBLIC_HOST=${PUBLIC}" \
  -e "AGENT_TOOLS_HANDOFF_PORT=${CONTAINER_HANDOFF}" \
  -e "AGENT_TOOLS_NOVNC_PORT=${CONTAINER_NOVNC}" \
  -e "AGENT_TOOLS_PUBLIC_HANDOFF_PORT=${HANDOFF_HOST}" \
  -e "AGENT_TOOLS_PUBLIC_NOVNC_PORT=${NOVNC_HOST}" \
  -e "AGENT_TOOLS_BROWSER_PROFILE=${PROFILE_PATH}" \
  "$IMAGE"

log_line "container run: $NAME"

# Container stderr is teed to the client stderr and the log. Stdout stays
# the MCP stream. A missing tee must not stop the launch.
if command -v mkfifo >/dev/null 2>&1 && command -v tee >/dev/null 2>&1; then
  STDERR_FIFO=/tmp/agent-tools-browser-$$.err
  if ! mkfifo "$STDERR_FIFO" 2>/dev/null; then
    STDERR_FIFO=
  fi
fi
if [ -n "$STDERR_FIFO" ]; then
  tee -a "$LOG_FILE" < "$STDERR_FIFO" >&2 &
  TEE_PID=$!
fi

# POSIX sh points a background command's stdin at /dev/null. Duplicate the
# client stdin onto fd 3 and redirect from that fd so MCP stdio still reaches
# the container, and the trap can run when this wait returns.
exec 3<&0
STDIN_DUP=1
if [ -n "$STDERR_FIFO" ]; then
  "$ENGINE" "$@" <&3 3<&- 2>"$STDERR_FIFO" &
else
  "$ENGINE" "$@" <&3 3<&- &
fi
RUN_PID=$!
status=0
wait "$RUN_PID" || status=$?
RUN_PID=
log_line "container exit $status"
if [ -n "${TEE_PID:-}" ]; then
  wait "$TEE_PID" 2>/dev/null || true
  TEE_PID=
fi
if [ -n "${STDERR_FIFO:-}" ]; then
  rm -f "$STDERR_FIFO" 2>/dev/null || true
  STDERR_FIFO=
fi
exit "$status"
