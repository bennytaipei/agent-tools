<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent-tools.browser-notify</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO_ROOT__/runtimes/browser/contrib/macos_notify.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_TOOLS_MACOS_NOTIFY_PORT</key>
    <string>8767</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/agent-tools-browser-notify.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/agent-tools-browser-notify.log</string>
</dict>
</plist>
