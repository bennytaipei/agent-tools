[
  {
    "name": "navigate",
    "description": "Open a URL in the remote browser. url is an absolute http or https URL. Example: {\"url\":\"https://example.com\"}.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Absolute URL to open."
        }
      }
    }
  },
  {
    "name": "read",
    "description": "Read the current page as viewport screenshots, the way a person looks at the screen. max_viewports is an integer from 1 to 30, default 10, and is how many viewports to capture. One image is one viewport. When truncated is true, call again with a higher max_viewports to see the rest of the page. Example: {\"max_viewports\":10}.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_viewports": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 10,
          "description": "Maximum number of viewports to capture. Defaults to 10."
        }
      }
    }
  },
  {
    "name": "screenshot",
    "description": "Capture the current viewport as one PNG. This tool takes no input fields. Example: {}.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  {
    "name": "handoff",
    "description": "Hand the live page to Benny, usually because it is a login wall. reason is why he has the browser. timeout is seconds to wait. done_when optionally names the page after sign-in with url_matches, selector_present, or text_present. url_matches ignores the query string and fragment. Only visible elements count. One call starts the share, notifies him, waits, and ends the share. Example: {\"reason\":\"login wall\",\"timeout\":120,\"done_when\":{\"url_matches\":\"https://app.example/home\"}}.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "timeout"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why Benny is being handed the live browser."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Seconds to block while Benny has the browser."
        },
        "done_when": {
          "description": "Names the page after sign-in, not the login page. Polled about once a second. Auto-complete only after the condition has been false at least once during this handoff and then true on two consecutive polls. A condition that is already true on the first poll does not auto-complete.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url_matches"
              ],
              "properties": {
                "url_matches": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Regular expression matched against the page URL without its query string or fragment (scheme://host[:port]/path). Name a post-login path."
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selector_present"
              ],
              "properties": {
                "selector_present": {
                  "type": "string",
                  "minLength": 1,
                  "description": "CSS selector for a visible element on the page after sign-in. Hidden elements do not count."
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text_present"
              ],
              "properties": {
                "text_present": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Substring of text that is visible on the page after sign-in. Hidden text does not count."
                }
              }
            }
          ]
        }
      }
    }
  },
  {
    "name": "click",
    "description": "Click an element on the current page. target is placeholder, label, text, css, role and optional name, point {x, y, scroll_y}, or a string resolved as placeholder, then label, then text, then CSS. button is left, right, or middle. click_count is how many times to click. modifiers are Alt, Control, Meta, Shift, or ControlOrMeta. A string as the whole arguments value is the target. Examples: {\"target\":{\"placeholder\":\"Search Admin Resources\"}} and {\"target\":{\"role\":\"button\",\"name\":\"Sign in\"}}.",
    "inputSchema": {
      "description": "A string is a bare target. An object carries target plus optional button, click_count, and modifiers.",
      "type": "object",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Bare target. Resolved with get_by_placeholder, then get_by_label, then get_by_text, then as a CSS selector."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target"
          ],
          "properties": {
            "target": {
              "description": "Element to click. placeholder, label, text, css, role and name, a point, or a string.",
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Bare target. Resolved with get_by_placeholder, then get_by_label, then get_by_text, then as a CSS selector."
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "placeholder"
                  ],
                  "properties": {
                    "placeholder": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Placeholder text for Playwright get_by_placeholder."
                    },
                    "nth": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Zero-based match when the locator matches more than one element."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Label text for Playwright get_by_label."
                    },
                    "nth": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Zero-based match when the locator matches more than one element."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "role"
                  ],
                  "properties": {
                    "role": {
                      "type": "string",
                      "minLength": 1,
                      "description": "ARIA role for Playwright get_by_role."
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Accessible name for get_by_role."
                    },
                    "nth": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Zero-based match when the locator matches more than one element."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Text for Playwright get_by_text."
                    },
                    "exact": {
                      "type": "boolean",
                      "description": "When true, get_by_text matches the whole string."
                    },
                    "nth": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Zero-based match when the locator matches more than one element."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "css"
                  ],
                  "properties": {
                    "css": {
                      "type": "string",
                      "minLength": 1,
                      "description": "CSS selector for Playwright locator."
                    },
                    "nth": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Zero-based match when the locator matches more than one element."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "description": "Horizontal viewport CSS pixel."
                    },
                    "y": {
                      "type": "number",
                      "description": "Vertical viewport CSS pixel."
                    },
                    "scroll_y": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Scroll the page to this offset before using x and y. Matches browser.read viewport scroll_y."
                    }
                  }
                }
              ]
            },
            "button": {
              "type": "string",
              "enum": [
                "left",
                "right",
                "middle"
              ],
              "default": "left",
              "description": "Mouse button."
            },
            "click_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 1,
              "description": "Number of clicks."
            },
            "modifiers": {
              "type": "array",
              "description": "Modifier keys held during the click.",
              "items": {
                "type": "string",
                "enum": [
                  "Alt",
                  "Control",
                  "Meta",
                  "Shift",
                  "ControlOrMeta"
                ]
              }
            }
          }
        }
      ]
    }
  },
