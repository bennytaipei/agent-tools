              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "description": "Horizontal viewport CSS pixel."
                },
                "y": {
                  "type": "number",
                  "description": "Vertical viewport CSS pixel."
                },
                "scroll_y": {
