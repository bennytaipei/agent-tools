            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Text for Playwright get_by_text."
                },
                "exact": {
                  "type": "boolean",
                  "description": "When true, get_by_text matches the whole string."
                },
                "nth": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Zero-based match when the locator matches more than one element."
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "css"
              ],
              "properties": {
                "css": {
                  "type": "string",
                  "minLength": 1,
                  "description": "CSS selector for Playwright locator."
                },
                "nth": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Zero-based match when the locator matches more than one element."
