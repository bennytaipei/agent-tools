  {
    "name": "wait_for",
    "description": "Wait until the current page shows a locator, hides a locator, contains text, matches a URL, or reaches a load state.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "description": "Locator to wait for. Use with state.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "description": "ARIA role for Playwright get_by_role."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Accessible name for get_by_role."
                },
                "nth": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Zero-based match when the locator matches more than one element."
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Text for Playwright get_by_text."
                },
                "exact": {
                  "type": "boolean",
                  "description": "When true, get_by_text matches the whole string."
                },
                "nth": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Zero-based match when the locator matches more than one element."
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "css"
              ],
              "properties": {
                "css": {
                  "type": "string",
                  "minLength": 1,
                  "description": "CSS selector for Playwright locator."
                },
                "nth": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Zero-based match when the locator matches more than one element."
                }
              }
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "visible",
            "hidden"
          ],
          "description": "Wait until the locator is visible or hidden."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Wait until this text is present."
        },
        "url_matches": {
          "type": "string",
          "minLength": 1,
          "description": "Regular expression matched against the page URL."
        },
        "load_state": {
          "type": "string",
          "enum": [
            "load",
            "domcontentloaded",
            "networkidle"
          ],
          "description": "Playwright load state to wait for."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000,
          "default": 10000,
          "description": "How long to wait, in milliseconds. Defaults to 10000."
        }
      },
      "oneOf": [
        {
          "required": [
            "target",
            "state"
          ],
          "properties": {
            "text": false,
            "url_matches": false,
            "load_state": false
          }
        },
        {
          "required": [
            "text"
          ],
          "properties": {
            "target": false,
            "state": false,
            "url_matches": false,
            "load_state": false
          }
        },
